[{"verso": "‘ahaṁ’-‘mama’ śabda arthe yāhā kichhu haya", "pagina": 103}, {"verso": "‘āmāra’ balite prabhu! āra kichhu nāi", "pagina": 107}, {"verso": "āmāra jīvana, sadā pāpe rata", "pagina": 74}, {"verso": "āmi ta’ svānanda-sukhada-vāsī", "pagina": 174}, {"verso": "ātma-nivedana, tuyā pade kari’", "pagina": 118}, {"verso": "ātma-samarpaṇe gelā abhimāna", "pagina": 150}, {"verso": "bhuliyā tomāre, saṁsāre āsiyā", "pagina": 57}, {"verso": "chhoḍata puruṣa-abhimāna", "pagina": 154}, {"verso": "dārā-putra-nija-deha-kuṭumba-pālane", "pagina": 130}, {"verso": "dekhite dekhite, bhuliba vā kabe", "pagina": 242}, {"verso": "ekhana bujhinu prabhu! tomāra charaṇa", "pagina": 141}, {"verso": "emana durmati, saṁsāra bhitare", "pagina": 86}, {"verso": "godruma-dhāme bhajana-anukūle", "pagina": 181}, {"verso": "gurudeva! baḍa kṛpā kari’, gauḍa-vana mājhe", "pagina": 225}, {"verso": "gurudeva! kabe mora sei dina ha’be", "pagina": 231}, {"verso": "gurudeva! kabe tava karuṇā prakāśe", "pagina": 235}, {"verso": "gurudeva! kṛpā-bindu diyā, kara’ ei dāse", "pagina": 228}, {"verso": "hari he! arthera sañchaye, viṣaya prayāse", "pagina": 198}, {"verso": "hari he! bhajane utsāha, bhaktite viśvāsa", "pagina": 202}, {"verso": "hari he! dāna, pratigraha, mitho gupta-kathā", "pagina": 205}, {"verso": "hari he! nīra-dharma-gata, jāhnavī-salile", "pagina": 212}, {"verso": "hari he! prapañche paḍiyā, agati ha-iyā", "pagina": 195}, {"verso": "hari he! saṅga-doṣa-śūnya dīkṣitādīkṣita", "pagina": 208}, {"verso": "hari he! śrī-rūpa-gosāñi, śrī-guru-rūpete", "pagina": 222}, {"verso": "hari he! tomāre bhuliyā, avidyā-pīḍāya", "pagina": 218}, {"verso": "kabe gaura-vane, suradhunī taṭe", "pagina": 239}, {"verso": "kabe ha’be bala se-dina āmāra", "pagina": 251}, {"verso": "keśava! tuyā jagata vichitra", "pagina": 159}, {"verso": "ki jāni ki bale, tomāra dhāmete", "pagina": 125}, {"verso": "kṛṣṇa-nāma dhare kata bala", "pagina": 259}, {"verso": "mānasa, deha, geha, yo kichhu mora", "pagina": 99}, {"verso"